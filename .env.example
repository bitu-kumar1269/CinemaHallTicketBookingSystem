PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/cinema_booking_db?schema=public"

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Seat Lock Duration in minutes
SEAT_LOCK_MINUTES=8

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# QR Code Verification Token Secret
QR_SIGNING_SECRET=your_qr_hmac_signing_secret

