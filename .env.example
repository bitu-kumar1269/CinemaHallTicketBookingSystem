# Backend Environment Variables
PORT=5005
NODE_ENV=production

# Frontend Client URL(s) - Comma-separated for multiple origins (e.g. http://localhost:5173,https://mycinema.vercel.app)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://cinema_admin:cinema_secure_password_2026@localhost:5432/cinema_booking_db?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Seat Lock Duration in minutes (Anti double-booking TTL)
SEAT_LOCK_MINUTES=8

# Razorpay Credentials (Test Mode or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# QR Code Verification Token Secret (HMAC-SHA256)
QR_SIGNING_SECRET=your_qr_hmac_signing_secret

# -------------------------------------------------------------
# Frontend Environment Variables (Only needed if frontend is hosted separately from backend)
# Set these in your frontend hosting platform (e.g., Vercel / Netlify):
# VITE_API_URL=https://your-backend-api.onrender.com/api
# VITE_SOCKET_URL=https://your-backend-api.onrender.com

